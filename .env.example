# Environment variables for Kopi Jago
# Copy to .env and fill with actual values

# Database
DB_HOST=localhost
DB_NAME=kopi_jago_db
DB_USER=root
DB_PASS=

# API Config
API_URL=http://localhost/kopi-jago/Rekayasa_E-Bisnis-Kopi_Jago/backend/api
TOKEN_TTL=86400

# Midtrans Payment Gateway (Sandbox)
MIDTRANS_SERVER_KEY=sandbox_server_key
MIDTRANS_CLIENT_KEY=sandbox_client_key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_CORE_URL=https://api.sandbox.midtrans.com/v2
